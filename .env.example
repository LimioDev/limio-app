# Copie este arquivo pra .env e preencha com a URL da API que quiser usar.
# O .env NÃO é versionado — peça as URLs de staging/produção pro time.
# Depois de mudar, reinicie o bundler com cache limpo: npx expo start -c

# Staging (branch develop)
# EXPO_PUBLIC_API_URL=https://<url-da-api-staging>

# Produção (branch main) — só pra testar build de release
# EXPO_PUBLIC_API_URL=https://<url-da-api-producao>

# API rodando local: emulador Android (10.0.2.2 = localhost da máquina host)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# API rodando local: celular físico na mesma rede (troque pelo IP da sua máquina)
# EXPO_PUBLIC_API_URL=http://<ip-da-sua-maquina>:8080
