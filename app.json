{
  "expo": {
    "name": "limio-app",
    "slug": "limio-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "limio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.limioapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.limioapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O LIMIO usa sua localização para mostrar serviços de limpeza próximos a você."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O LIMIO acessa suas fotos para anexá-las ao anúncio e ao check-out do serviço.",
          "cameraPermission": "O LIMIO usa a câmera para fotografar o anúncio e o check-out do serviço."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8080"
    }
  }
}
